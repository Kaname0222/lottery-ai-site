# 数据库：开发期可用 SQLite，生产用 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./lottery_ai.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/lottery_ai

# LLM API Keys（用户需自行申请并填入）
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
DOUBAO_API_KEY=
QIANWEN_API_KEY=

# 各模型默认名称，如需更换可在 .env 中覆盖
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-1.5-flash
# DEEPSEEK_MODEL=deepseek-chat
# KIMI_MODEL=moonshot-v1-8k
# QIANWEN_MODEL=qwen-turbo

# 是否启用对应模型（true/false），关闭后预测任务会跳过该模型
# OPENAI_ENABLED=true
# GEMINI_ENABLED=true
# DEEPSEEK_ENABLED=true
# KIMI_ENABLED=true
# DOUBAO_ENABLED=true
# QIANWEN_ENABLED=true

# 豆包/火山方舟配置
# base_url 固定为：https://ark.cn-beijing.volces.com/api/v3
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
# model 需要填你的【推理接入点 ID】，格式通常是 ep-xxxxxxxxxx
# 在火山方舟控制台 https://console.volcengine.com/ark/ 的“在线推理”->“推理接入点”里创建或查看
DOUBAO_MODEL=

# 千问/通义千问配置
# base_url 固定为：https://dashscope.aliyuncs.com/compatible-mode/v1
# model 可选：qwen-turbo, qwen-plus, qwen-max 等
# QIANWEN_MODEL=qwen-turbo

# 爬虫配置
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_RETRY_TIMES=3

# 应用配置
APP_ENV=development
LOG_LEVEL=INFO

# 是否启动后端定时任务（赛程抓取 + LLM 预测 + 赛果评分）。
# 生产环境部署在 Render 等 PaaS 上时建议设为 false，由 GitHub Actions 执行爬虫，避免实例内存不足或休眠导致任务失败。
SCHEDULED_PIPELINE_ENABLED=true
